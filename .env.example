# Copy to .env and adjust. These are read by Hayhooks / mcp_toolset.

# --- Hayhooks REST server ---
HAYHOOKS_HOST=localhost
HAYHOOKS_PORT=1416

# --- Hayhooks MCP server (hayhooks mcp run) ---
HAYHOOKS_MCP_HOST=localhost
HAYHOOKS_MCP_PORT=1417

# Directory of deployable pipeline wrappers (auto-loaded on startup).
HAYHOOKS_PIPELINES_DIR=./pipeline_wrappers

# Show full tracebacks in responses during development.
HAYHOOKS_SHOW_TRACEBACKS=true

# --- mcp_toolset ---
# Where YouTubeTranscriptFetcher transcripts are written as markdown.
MCP_TOOLSET_TRANSCRIPTS_DIR=./data/transcripts

# --- Optional: only needed for the documented LLM "answer over transcript" upgrade ---
# OPENAI_API_KEY=sk-...
